# Magister local configuration example.
# Copy to .env and fill in values. Never commit .env to git.

# ── Server ────────────────────────────────────────────────────────────

MAGISTER_HOST=127.0.0.1
MAGISTER_PORT=18793

# Public bind is off by default. Set both to expose on every interface:
# MAGISTER_HOST=0.0.0.0
# MAGISTER_ALLOW_PUBLIC_BIND=true
MAGISTER_ALLOW_PUBLIC_BIND=false

# ── Paths ─────────────────────────────────────────────────────────────

# State directory — magister.db, receipts, uploads
MAGISTER_STATE_DIR=./state

# Curriculum directory — subject configs (latin, mandarin, etc.)
MAGISTER_CURRICULUM_DIR=./curriculum

# Receipts directory (defaults to <state>/receipts)
# MAGISTER_RECEIPTS_DIR=./state/receipts

# ── LLM (companion chat) ──────────────────────────────────────────────
# OpenRouter is the primary cloud provider for companion chat.
# Local-only mode uses Ollama on the local network.

# OPENROUTER_API_KEY=sk-or-...
# MAGISTER_LLM_MODEL=anthropic/claude-haiku-4-5
# MAGISTER_LOCAL_OLLAMA_URL=http://127.0.0.1:11434
# MAGISTER_LOCAL_OLLAMA_MODEL=qwen2.5:7b
# Set to true to disable cloud calls entirely and require Ollama:
# MAGISTER_LOCAL_ONLY=false

# ── Voice ─────────────────────────────────────────────────────────────
# Local TTS (Piper) and STT (whisper.cpp) binary paths.

# PIPER_BIN=/home/zen/.local/bin/piper
# PIPER_VOICES_DIR=/home/zen/.local/share/piper-voices
# WHISPER_BIN=/mnt/ai/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=/mnt/ai/whisper.cpp/models/ggml-base.en.bin
# WHISPER_MODEL_MULTILINGUAL=/mnt/ai/whisper.cpp/models/ggml-base.bin

# ── Kokoro local voice service (Slice 6D) ────────────────────────────
# Optional. Magister dispatches POST /magister/tts to this service when a
# voice profile has engine:"kokoro". Without it, Piper is used.
#
# The /health probe requires the response to identify as
# engine:"kokoro". If another uvicorn sidecar (e.g. opencode-sidecar) is
# squatting :18794, the probe will reject it and the registry will mark
# Kokoro as not reachable rather than silently route TTS through the
# wrong service. Either stop the squatter or point this var at the
# Kokoro instance's real address.

# Default — Kokoro runs on its standard port.
# MAGISTER_KOKORO_URL=http://127.0.0.1:18794

# Use when 18794 is occupied (e.g. opencode-sidecar on the dev box).
# Run Kokoro on the alternate port with the matching env var:
#   cd voices/kokoro && MAGISTER_KOKORO_PORT=18894 ./start.sh
# 18894 is just an example — pick any free loopback port and keep the
# two env vars in agreement. See docs/MAGISTER_KOKORO_RUNTIME.md for
# the full alternate-port workflow including how to restart the API.
# MAGISTER_KOKORO_URL=http://127.0.0.1:18894

# Synthesised audio is content-addressed at state/voices/cache/<sha256>.wav.
# LRU eviction triggers after each successful write.
# MAGISTER_VOICE_CACHE_MAX_MB=500

# Fall through to Piper if Kokoro generation fails. Off by default.
# MAGISTER_VOICE_FALLBACK=piper

# Premium cloud TTS (optional)
# ELEVENLABS_API_KEY=
