node_modules/
# Build output (nusika's own dist only — anchored so the vendored, prebuilt
# vendor/velum-ai/dist is still committed and travels with a fresh clone).
/dist/
*.log

# Next.js build artifacts (web/)
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Local state — DBs, receipts, uploads, tmp
state/
!state/.gitkeep

# Environment / secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Build / cache
.next/
.turbo/
*.tsbuildinfo

# Test artifacts
coverage/
.nyc_output/

# Aedis repo index — external tool cache, regenerated on demand.
.aedis/

# Voices: per-sub-service artifacts (kokoro/.venv at ~5 GB, kokoro/__pycache__,
# generated *.wav scratch) are handled by voices/kokoro/.gitignore.
# Any future voice engine added under voices/ should ship its own nested
# .gitignore so we never accidentally stage gigabytes of model/venv state.
*.tgz
