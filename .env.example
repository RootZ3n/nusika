# Magister local configuration example.
# Copy to .env and fill in values. Never commit .env to git.

# ── Server ────────────────────────────────────────────────────────────

MAGISTER_HOST=127.0.0.1
MAGISTER_PORT=18793

# Public bind is off by default. Set both to expose on every interface:
# MAGISTER_HOST=0.0.0.0
# MAGISTER_ALLOW_PUBLIC_BIND=true
MAGISTER_ALLOW_PUBLIC_BIND=false

# ── Paths ─────────────────────────────────────────────────────────────

# State directory — magister.db, receipts, uploads
MAGISTER_STATE_DIR=./state

# Curriculum directory — subject configs (latin, mandarin, etc.)
MAGISTER_CURRICULUM_DIR=./curriculum

# Receipts directory (defaults to <state>/receipts)
# MAGISTER_RECEIPTS_DIR=./state/receipts

# ── LLM (companion chat) ──────────────────────────────────────────────
# OpenRouter is the primary cloud provider for companion chat.
# Local-only mode uses Ollama on the local network.

# OPENROUTER_API_KEY=sk-or-...
# MAGISTER_LLM_MODEL=anthropic/claude-haiku-4-5
# MAGISTER_LOCAL_OLLAMA_URL=http://127.0.0.1:11434
# MAGISTER_LOCAL_OLLAMA_MODEL=qwen3.5:9b

# ── Voice ─────────────────────────────────────────────────────────────
# Local TTS (Piper) and STT (whisper.cpp) binary paths.

# PIPER_BIN=/home/zen/.local/bin/piper
# PIPER_VOICES_DIR=/home/zen/.local/share/piper-voices
# WHISPER_BIN=/mnt/ai/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=/mnt/ai/whisper.cpp/models/ggml-base.en.bin
# WHISPER_MODEL_MULTILINGUAL=/mnt/ai/whisper.cpp/models/ggml-base.bin

# Premium cloud TTS (optional)
# ELEVENLABS_API_KEY=
