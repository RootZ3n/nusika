# nusika-voice — runtime environment TEMPLATE.
#
# Copy to nusika-voice.env (gitignored) in the runtime/deploy location and
# edit. Loaded by start.sh and by the systemd unit (EnvironmentFile).
# Contains no secrets — only bind address, port, venv, and cache paths.

# Bind loopback only. Nusika (same host) reaches it over 127.0.0.1.
NUSIKA_KOKORO_HOST=127.0.0.1
NUSIKA_KOKORO_PORT=18794
NUSIKA_KOKORO_LOG_LEVEL=INFO

# Reuse an existing runtime venv instead of building a new ~5 GB one.
# On pop-peh the deployed venv lives here:
NUSIKA_VOICE_VENV=/pehverse/services/nusika-voice/.venv

# Keep all model/asset downloads on the /pehverse data drive, never in the
# home dir, never under /mnt/ai or /hogwarts. Kokoro-82M caches here on the
# first /generate call (~330 MB).
HF_HOME=/pehverse/cache/huggingface
XDG_CACHE_HOME=/pehverse/cache
TMPDIR=/pehverse/tmp/general
