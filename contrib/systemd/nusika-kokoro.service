[Unit]
# Nusika Kokoro — local TTS sub-service, loopback only.
#
# Bound to 127.0.0.1:18794. Nusika API dispatches POST /nusika/tts
# here when a voice profile has engine:"kokoro". Bypasses start.sh on
# purpose: we don't want pip install running on every boot — run
# `voices/kokoro/start.sh` once manually to provision the venv, then
# this unit just exec's uvicorn directly.
Description=Nusika Kokoro voice service (loopback)
Documentation=https://github.com/anthropics/claude-code
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/ai/magister/voices/kokoro
ExecStart=/mnt/ai/magister/voices/kokoro/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 18794 --log-level info
Environment=NUSIKA_KOKORO_HOST=127.0.0.1
Environment=NUSIKA_KOKORO_PORT=18794
Environment=NUSIKA_KOKORO_LOG_LEVEL=INFO
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/ai/magister/voices/kokoro

[Install]
WantedBy=default.target
