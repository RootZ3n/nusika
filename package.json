{
  "name": "magister",
  "version": "0.1.0",
  "description": "Adaptive learning engine — companion-driven teaching, spaced repetition, mastery spine, creative portfolio.",
  "main": "dist/server/index.js",
  "type": "module",
  "private": true,
  "files": [
    "dist/",
    "curriculum/",
    "docs/",
    "README.md",
    ".env.example",
    "LICENSE"
  ],
  "scripts": {
    "start": "tsx server/index.ts",
    "start:dist": "node dist/server/index.js",
    "dev": "tsx watch server/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts server/**/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "service:install": "node scripts/install-systemd.mjs",
    "service:health": "node scripts/magister-health.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/multipart": "^8.3.0",
    "better-sqlite3": "^11.5.0",
    "fastify": "^4.28.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
