# /etc/systemd/system/nusika-voice.service
# pop-peh lab service: nusika-voice — local Kokoro TTS for Nusika (port 18794).
#
# Repo-owned template. Canonical source: /pehverse/repos/nusika/voice/.
# Runs the repo-owned start.sh; the venv + real env file stay outside git
# (see voice/.gitignore). Rebuilt cleanly on pop-peh. No Mushin dependency.
#
# Install:
#   sudo install -m 644 /pehverse/repos/nusika/voice/systemd/nusika-voice.service \
#     /etc/systemd/system/nusika-voice.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nusika-voice.service
[Unit]
Description=pop-peh lab service: nusika-voice (local Kokoro TTS, port 18794)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zen
Group=zen
WorkingDirectory=/pehverse/repos/nusika/voice
# Real env file is gitignored; copy voice/nusika-voice.env.example to create it.
# The leading '-' makes it optional so the unit still starts with built-in defaults.
EnvironmentFile=-/pehverse/repos/nusika/voice/nusika-voice.env
# start.sh loads the env file, ensures the venv, and execs uvicorn on the
# loopback port. It reuses NUSIKA_VOICE_VENV (set in the env file) so the
# ~5 GB environment is not rebuilt on every boot.
ExecStart=/pehverse/repos/nusika/voice/start.sh
Restart=on-failure
RestartSec=5
# First /generate downloads the Kokoro-82M model (~330 MB); give it room.
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
