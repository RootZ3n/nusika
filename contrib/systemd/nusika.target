[Unit]
# Nusika umbrella target.
#
# Starts the API, Kokoro voice sub-service, and Web frontend together.
# Use `systemctl --user start nusika.target` to bring everything up,
# `systemctl --user stop nusika.target` to take it all down.
#
# Truth model (post 2026-05-22 fix):
#   - nusika-api.service is Requires=, so the target CANNOT be active
#     if the API is dead. This avoids the prior "lies-by-omission" failure
#     mode where Wants= let the target stay green while the API was gone.
#   - nusika-kokoro.service and nusika-web.service stay as Wants=:
#     they're useful on their own (Kokoro can preview voices; web can at
#     least serve the API-down banner) and we'd rather a partial stack
#     keep degrading visibly than have everything cascade-stop.
#   - For `systemctl --user is-active nusika.target` to mean "Nusika
#     is actually usable", you need the API line. Hence Requires=.
#
# Note: Requires= here means "if nusika-api.service stops, this target
# transitions out of active too". It does NOT cause web/kokoro to stop —
# those have no PartOf=nusika.target binding, so they survive an API
# outage. That's intentional: the target is a truth marker, not a kill
# switch.
Description=Nusika (API + Kokoro + Web)
Requires=nusika-api.service
Wants=nusika-kokoro.service nusika-web.service
After=nusika-api.service nusika-kokoro.service nusika-web.service

[Install]
WantedBy=default.target
