{
  "name": "nusika",
  "version": "0.1.0",
  "description": "Adaptive learning engine — companion-driven teaching, spaced repetition, mastery spine, creative portfolio.",
  "main": "dist/server/index.js",
  "type": "module",
  "author": "RootZ3n <rootz3n@proton.me>",
  "files": [
    "dist/",
    "curriculum/",
    "docs/",
    "README.md",
    ".env.example",
    "LICENSE"
  ],
  "scripts": {
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "start:dist": "node dist/server/index.js",
    "dev": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts server/**/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "service:install": "node scripts/install-systemd.mjs",
    "service:health": "node scripts/nusika-health.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "velum-ai": "^0.2.2",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "better-sqlite3": "^11.5.0",
    "fastify": "^4.28.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RootZ3n/nusika.git"
  },
  "homepage": "https://github.com/RootZ3n/nusika#readme",
  "keywords": [
    "adaptive-learning",
    "spaced-repetition",
    "companion-driven",
    "tts",
    "stt",
    "education",
    "curriculum",
    "tutoring",
    "fastify",
    "sqlite"
  ],
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
