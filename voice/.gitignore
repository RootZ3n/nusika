# Nusika voice service — local runtime artifacts only. Never commit the
# venv (~5 GB), Kokoro model files, the real env file, or generated audio.

# Python virtual environment (created by start.sh).
.venv/

# Python bytecode and caches.
__pycache__/
*.pyc
*.pyo
*.pyd

# Real env file (secrets/paths). Only nusika-voice.env.example is tracked.
nusika-voice.env
.env

# Model / HF cache, if ever pointed inside this folder.
cache/
models/
hf-cache/

# Generated audio: scratch from manual probes, smoke runs, and the
# dispatch cache. Tracked sample fixtures, if any, must be added with -f
# and documented in samples/README.md.
*.wav
samples/*.wav
